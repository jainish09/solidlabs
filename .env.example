# SolidLabs Backend Configuration Example
# Copy this file to .env and adjust variables as needed

# Application
APP_NAME=SolidLabs AI Manufacturing API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8001

# Security & CORS
# Comma-separated list of origins allowed to make CORS requests
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Database
# Default: Local SQLite database. For PostgreSQL / Supabase, use:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/solidlabs
DATABASE_URL=sqlite:///./solidlabs.db

# Storage & Upload Limits
MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB
UPLOAD_TEMP_DIR=./storage/temp_uploads
CAD_STORAGE_DIR=./storage/cad_assets
EXPORTS_STORAGE_DIR=./storage/exports
DEFAULT_STL_UNITS=mm


# AI Service Configuration
# AI is optional. If API key is not provided, the system seamlessly uses
# high-precision deterministic engineering fallback synthesis.
AI_PROVIDER=none  # options: none, openai, gemini
AI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini
AI_TIMEOUT_SECONDS=10
